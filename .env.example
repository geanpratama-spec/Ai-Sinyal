# =======================================================
# File Template .env.example untuk Vercel Deployment
# Copy file ini menjadi .env dan isi nilai API Key Anda
# =======================================================

# 1. API Key Server-side (Untuk Serverless Function Vercel /api/analyze-signal)
# Dapatkan Gemini API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Dapatkan Claude API Key di: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 2. Client-side Environment Variables (Dimulai dengan VITE_)
VITE_GEMINI_API_KEY=
VITE_CLAUDE_API_KEY=

# 3. Mode Lingkungan
NODE_ENV=production
